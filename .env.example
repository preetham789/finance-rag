# .env.example — copy this to .env and fill in your keys
# cp .env.example .env   (macOS/Linux)
# copy .env.example .env  (Windows)

# Required: get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: only needed for RAGAS evaluation or OpenAI LLM
OPENAI_API_KEY=sk-your_openai_key_here

# Security & API Authentication
# AUTH_MODE: apikey (enforces X-API-Key header) | off (local dev only)
AUTH_MODE=apikey
API_KEYS=dev-admin-key:admin,dev-analyst-key:analyst,dev-public-key:public
API_KEY=dev-admin-key
EVAL_API_KEY=dev-admin-key
RATE_LIMIT_PER_MIN=60

# Grounding check: false logs reports; true replaces ungrounded answers with refusal text
GROUNDING_STRICT=false

# Retrieval & Reranker tuning
# HYBRID_ALPHA: BM25/dense blend weight (0.0 = pure BM25, 1.0 = pure dense, 0.7 = finance tuned)
HYBRID_ALPHA=0.7
# Optional cross-encoder reranker (e.g. cross-encoder/ms-marco-MiniLM-L-6-v2)
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAGAS Evaluation judge model (Groq-hosted, e.g. llama-3.1-8b-instant, llama-3.3-70b-versatile)
RAGAS_JUDGE_MODEL=llama-3.1-8b-instant

# Optional: override the Streamlit frontend URL for CORS (production only)
# CORS_ORIGINS=http://localhost:8501,http://localhost:8000
